# ==============================================================================
# Gen6th Accord — Environment Template
# ==============================================================================
# Copy to `.env` and fill in REAL values locally / on the server ONLY.
#   cp .env.example .env
# The real .env is NEVER committed. Placeholders below are intentionally fake.
# ==============================================================================

# --- Runtime ---
# ENVIRONMENT is the source of truth for runtime mode. Outside `development` the config
# validator fails closed: real secrets are REQUIRED (no insecure fallback).
ENVIRONMENT=development
LOG_LEVEL=info

# --- Application secrets (REQUIRED outside development) ---
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# --- Database ---
# Outside development use cloud_sql_proxy with the same-instance 127.0.0.1:5432 sidecar.
# DATABASE_URL comes from private configuration; no URL query transport overrides.
DATABASE_TRANSPORT=local
DATABASE_URL=postgresql+asyncpg://appuser:CHANGE_ME_STRONG_PASSWORD@postgres:5432/appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=appdb

# --- Redis (compliance spine) ---
REDIS_URL=redis://redis:6379/0
# Required for production/Google mode: absolute path to a mounted service CA bundle.
# Use rediss:// with no query options; verification is always required.
REDIS_CA_CERT_PATH=

# Only enable when a trusted reverse proxy fronts the service (the deploy stack sets this
# itself, in docker-compose.yml). Off means the recorded client IP is the peer address —
# the only value the server observed without a proxy.
TRUST_X_FORWARDED_FOR=false

# --- Zynth workspace integration (disabled until owner configuration and SQL proof) ---
PERSONA_API_ENABLED=false
PERSONA_CREDITS_ENABLED=false
PERSONA_LIFECYCLE_ENABLED=false
ZYNTH_ISSUER=
ZYNTH_CLIENT_ID=
ZYNTH_CLIENT_SECRET=
ZYNTH_TENANT_ID=
PERSONA_WORKSPACE_ID=
# Generate locally: openssl rand -hex 32. Never paste the value into chat.
ZYNTH_SESSION_KEY=
ACCORD_APP_ORIGIN=
# Frontend server flags; no credentials are exposed to NEXT_PUBLIC variables.
ACCORD_CONNECTION_ENABLED=false
ACCORD_API_ORIGIN=

# --- Optional portraits (owner-reviewed providers, schema and Linux runtime required) ---
PERSONA_PHOTOS_ENABLED=false
PERSONA_EVIDENCE_ENABLED=false
PERSONA_PUBLIC_PASSPORTS_ENABLED=false
PHOTO_CLAMD_PORT=3310
PHOTO_VAULT_ADDRESS=
PHOTO_VAULT_TOKEN=
PHOTO_VAULT_KEY=

# --- S7 Google runtime (owner-reviewed Cloud Run/IAM/keys/schema/benchmark only) ---
# JSON contract and activation prerequisites: docs/hackathon/google-runtime-slice.md
# Requires approved identity/photos, matching workspace and TLS Redis; no credential files.
PERSONA_GOOGLE_ENABLED=false
PERSONA_GOOGLE_CONFIG=
# Advisory reviewer brief (ADR-0074): Gemini on Vertex AI. Off unless enabled; project must be set.
PERSONA_ASSISTANT_ENABLED=false
PERSONA_ASSISTANT_PROJECT=
PERSONA_ASSISTANT_REGION=global
PERSONA_ASSISTANT_MODEL=gemini-3.8-flash

# --- Ingress bind address ---
# Which host interface Caddy publishes on. Defaults to 127.0.0.1 (loopback) so a local
# `docker compose up` is not reachable from the LAN. On the production server set:
#   BIND_HOST=0.0.0.0
BIND_HOST=127.0.0.1

# --- Container images ---
# LOCAL: `docker compose up --build` builds these tags (docker-compose.override.yml).
# PRODUCTION: set to the exact SIGNED digest CI published, then run deploy/verify.sh, e.g.
#   BACKEND_IMAGE=ghcr.io/ajalcance/gen6th-accord-backend@sha256:...
BACKEND_IMAGE=gen6th-accord-backend:latest
FRONTEND_IMAGE=gen6th-accord-frontend:latest
